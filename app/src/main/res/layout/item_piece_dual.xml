<?xml version="1.0" encoding="utf-8"?>
<!--
  绝缘子片列表项-双联（对应 .piece-list.dual .piece，紧凑样式，无序号列）
  210dp 面板下左/右串格约 80dp（行序号列约 23dp、列间隔约 4dp），行高 34dp；
  内容居中撑满格宽（对应 HTML justify-content:center），避免格内留白形成列间黑带
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pieceRoot"
    android:layout_width="match_parent"
    android:layout_height="31dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_piece_idle"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <com.skydroid.insulatordetect.ui.InsulatorIconView
        android:id="@+id/iconInsulator"
        android:layout_width="24dp"
        android:layout_height="24dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/dt_txt3"
            android:textSize="11sp"
            tools:text="1250 MΩ" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="10sp"
            tools:text="合格" />
    </LinearLayout>
</LinearLayout>
