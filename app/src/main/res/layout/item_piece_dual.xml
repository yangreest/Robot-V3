<?xml version="1.0" encoding="utf-8"?>
<!-- 绝缘子片列表项-双联（对应 .piece-list.dual .piece，紧凑样式，无序号列） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pieceRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_piece_idle"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="5dp"
    android:paddingEnd="4dp"
    android:paddingBottom="5dp">

    <com.skydroid.insulatordetect.ui.InsulatorIconView
        android:id="@+id/iconInsulator"
        android:layout_width="28dp"
        android:layout_height="28dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/dt_txt3"
            android:textSize="11sp"
            tools:text="1250 MΩ" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="9sp"
            tools:text="合格" />
    </LinearLayout>
</LinearLayout>
