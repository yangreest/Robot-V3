<?xml version="1.0" encoding="utf-8"?>
<!--
  瓷绝缘子零值检测机器人 手持终端主界面
  布局完全参照 Robot-V3/低值零值智能研判平台.html：
  FrameLayout 分层，子 View 顺序对应 HTML z-index 层级
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161A">

    <!-- ===== 视频背景层（对应 #videoCanvas，摄像头图传全屏显示） ===== -->
    <com.skydroid.fpvplayer.FPVWidget
        android:id="@+id/fpvWidget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#10161A" />

    <!-- 图传水印（对应 drawVideo 中 CAM1 水印） -->
    <TextView
        android:id="@+id/tvWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="monospace"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        tools:text="CAM1 · 1080P · 09:24:31" />

    <!-- ===== 顶部状态栏（对应 .topbar，z:20） ===== -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_topbar_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- 品牌区（对应 .brand） -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/detect_app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:paddingStart="9dp"
            android:paddingEnd="0dp"
            android:text="@string/detect_app_name"
            android:textColor="#DBE7DF"
            android:textSize="12sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="9dp"
            android:background="#38FFFFFF" />

        <!-- 状态徽章（对应 .status-badge） -->
        <LinearLayout
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_idle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/shape_dot" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="非检测"
                android:textColor="@color/dt_txt"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 中部信息（对应 .top-mid） -->
        <TextView
            android:id="@+id/tvTopLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="11.5sp"
            tools:text="线路 750kV城苏2线" />

        <TextView
            android:id="@+id/tvTopTower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="11.5sp"
            tools:text="杆塔 #020" />

        <TextView
            android:id="@+id/tvTopMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="11.5sp"
            tools:text="模式 自动" />

        <TextView
            android:id="@+id/tvTopDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="11.5sp"
            tools:text="已测 0/60" />

        <TextView
            android:id="@+id/tvTopBad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="11.5sp"
            tools:text="劣化 0" />

        <!-- 右侧（对应 .top-right） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSigLine1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dt_txt2"
                    android:textSize="10.5sp"
                    tools:text="信号延迟 11ms　信号质量 100%" />

                <TextView
                    android:id="@+id/tvSigLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dt_txt2"
                    android:textSize="10.5sp"
                    tools:text="信号强度 -58dBm" />
            </LinearLayout>

            <!-- 双电池（对应 .bats） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="11dp"
                tools:ignore="RtlSymmetry">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.skydroid.insulatordetect.ui.BatteryView
                        android:id="@+id/batRobot"
                        android:layout_width="13dp"
                        android:layout_height="20dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="机器人"
                            android:textColor="#E6FFFFFF"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/tvBatRobot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            tools:text="82%" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="13dp"
                    android:layout_marginEnd="13dp"
                    android:background="#3DFFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.skydroid.insulatordetect.ui.BatteryView
                        android:id="@+id/batAndroid"
                        android:layout_width="13dp"
                        android:layout_height="20dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="安卓"
                            android:textColor="#E6FFFFFF"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/tvBatAndroid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            tools:text="76%" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ⋯ 菜单按钮（对应 .dots） -->
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_dots"
                android:contentDescription="菜单"
                android:padding="8dp"
                android:src="@drawable/ic_dots" />
        </LinearLayout>
    </LinearLayout>

    <!-- 顶栏底部绿色分隔线（对应 .topbar::after） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:background="@color/dt_green" />

    <!-- ===== 左侧绝缘子串面板（对应 .string-panel，z:15） ===== -->
    <LinearLayout
        android:id="@+id/stringPanel"
        android:layout_width="278dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="52dp"
        android:background="@drawable/bg_left_panel"
        android:orientation="vertical">

        <!-- 当前相别（对应 .phase-ind） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_phase_ind"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前相别"
                android:textColor="@color/dt_txt2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/dt_green"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="A相" />
        </LinearLayout>

        <!-- 左串/右串 Tab（对应 .tabs.small，双联时隐藏） -->
        <LinearLayout
            android:id="@+id/sideTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tabLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="左串"
                android:textColor="@color/dt_txt2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabRight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="右串"
                android:textColor="@color/dt_txt2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 串信息（对应 .str-meta） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvStrInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="@color/dt_txt2"
                android:textSize="11sp"
                tools:text="A相 · 双联 左串/右串" />

            <TextView
                android:id="@+id/tvOkBad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/dt_txt2"
                android:textSize="11sp"
                tools:text="合格 0 · 异常 0" />
        </LinearLayout>

        <!-- 绝缘子片列表（对应 .piece-list） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPieces"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="60dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- ===== 手柄按键/通道显示条（需求3：按了哪个按钮，界面有显示） ===== -->
    <HorizontalScrollView
        android:id="@+id/rcStripScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="294dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_toast"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rcStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- ===== 右上信息卡（对应 .info-card，z:14） ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_info_card"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvEnv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dt_txt2"
            android:textSize="12sp"
            tools:text="环境温度 20℃　湿度 33%RH　风速 3.2m/s" />

        <TextView
            android:id="@+id/tvKvTh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dt_txt2"
            android:textSize="12sp"
            tools:text="电压档位 50kV　阈值 500MΩ" />

        <TextView
            android:id="@+id/tvProbe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dt_txt2"
            android:textSize="12sp"
            tools:text="探针状态 复位" />

        <!-- 拍照按钮（对应 .cam-btn） -->
        <ImageView
            android:id="@+id/btnShot"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_cam_btn"
            android:contentDescription="拍照"
            android:padding="8dp"
            android:src="@drawable/ic_camera" />
    </LinearLayout>

    <!-- ===== 右下曲线面板（对应 .right-col/.curve-panel，z:14） ===== -->
    <LinearLayout
        android:layout_width="432dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="86dp"
        android:background="@drawable/bg_curve_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="高压冲击响应曲线（kV）"
            android:textColor="@color/dt_txt2"
            android:textSize="12sp" />

        <com.skydroid.insulatordetect.ui.CurveView
            android:id="@+id/curveView"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- ===== 录制计时器（对应 .rec-timer，z:15） ===== -->
    <LinearLayout
        android:id="@+id/recTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="240dp"
        android:background="@drawable/bg_rec_timer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:id="@+id/recDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/shape_rec_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="REC"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvRecTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 底部控制区（对应 .controls，z:16） ===== -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <!-- 模式切换（对应 #modeBtn） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btnMode"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_ctl_btn">

                <ImageView
                    android:id="@+id/ivMode"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="切换检测模式"
                    android:src="@drawable/ic_mode" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="自动"
                android:textColor="@color/dt_txt2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 开始检测主按钮（对应 #startBtn） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btnStart"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_ctl_btn_main">

                <ImageView
                    android:id="@+id/ivStart"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="开始检测"
                    android:src="@drawable/ic_play" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="开始检测"
                android:textColor="@color/dt_green"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 录制（对应 #recBtn） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btnRec"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_ctl_btn">

                <ImageView
                    android:id="@+id/ivRec"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="录制"
                    android:src="@drawable/ic_record" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvRec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="录制"
                android:textColor="@color/dt_txt2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 急停（对应 #estopBtn） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btnEstop"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_ctl_btn_stop">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="急停"
                    android:src="@drawable/ic_estop" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="急停"
                android:textColor="@color/dt_red"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 报警条（对应 .alarm-bar，z:30） ===== -->
    <LinearLayout
        android:id="@+id/alarmBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_alarm_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:translationY="-90dp"
        tools:translationY="0dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="报警"
            android:src="@drawable/ic_alarm" />

        <TextView
            android:id="@+id/tvAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="发现劣化绝缘子"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ===== 自定义 Toast（对应 .toast，z:60） ===== -->
    <TextView
        android:id="@+id/customToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="110dp"
        android:alpha="0"
        android:background="@drawable/bg_toast"
        android:paddingStart="20dp"
        android:paddingTop="9dp"
        android:paddingEnd="20dp"
        android:paddingBottom="9dp"
        android:textColor="@color/dt_txt"
        android:textSize="13sp"
        tools:alpha="1"
        tools:text="提示消息" />

    <!-- ===== 拍照白闪（对应 .flash，z:70） ===== -->
    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/white" />

    <!-- ===== 右侧抽屉遮罩（对应 .drawer-mask，z:40） ===== -->
    <View
        android:id="@+id/drawerMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#59000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- ===== 右侧抽屉（对应 .drawer，z:41） ===== -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/dt_drawer_bg"
        android:orientation="horizontal"
        android:translationX="470dp">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/drawerPager"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1AFFFFFF" />

        <!-- 竖排 Tab（对应 .drawer-tabs） -->
        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dtabLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dtab"
                android:gravity="center"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:text="线路设置"
                android:textColor="@color/dt_txt2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dtabParam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dtab"
                android:gravity="center"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:text="参数配置"
                android:textColor="@color/dt_txt2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dtabSys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dtab"
                android:gravity="center"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:text="系统信息"
                android:textColor="@color/dt_txt2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
