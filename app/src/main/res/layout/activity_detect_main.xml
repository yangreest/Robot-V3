<?xml version="1.0" encoding="utf-8"?>
<!--
  瓷绝缘子零值检测机器人 手持终端主界面
  目标设备：1200×1920px / 400×640dp（density 3.0），横屏全屏可用区域 640dp × 400dp

  分区（FrameLayout 分层，子 View 顺序 = z 轴层级，自上而下）：
    ┌──────────────────── topbar 46dp（y 0..46）────────────────────────┐
    ├ stringPanel 240dp ┬─────── 图传视频区 x 248..632 ────────────────┤
    │  y 44..338        │  遥测条      y  50..76                        │
    │  相别 / 统计 /    │  水印 · REC  y  82..110                       │
    │  绝缘子片列表     │  报警条      y 118..170（瞬态）               │
    │                   │  浮层带      y 176..224（提示/Toast）         │
    │                   │  曲线面板    y 219..330                       │
    ├───────────────────┴──── bottomBar 62dp（y 338..400）─────────────┤
    │ 手柄通道 chip 条（左 190dp） | 拍照 · 模式 · 开始 · 录制 · 急停   │
    └──────────────────────────────────────────────────────────────────┘
  所有可点击控件高度 ≥ 44dp；瞬态浮层（报警/Toast/白闪）置于高层级且不拦截触摸。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161A">

    <!-- ===== 视频层（对应 #videoCanvas，摄像头图传全屏铺底） ===== -->
    <com.skydroid.fpvplayer.FPVWidget
        android:id="@+id/fpvWidget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- ===== 模拟图传层：无 RTSP 视频流时显示，收到首帧后自动隐藏 ===== -->
    <FrameLayout
        android:id="@+id/camPreviewLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivCamPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="模拟摄像头回传画面"
            android:scaleType="centerCrop"
            android:src="@drawable/cam_preview" />

        <TextView
            android:id="@+id/tvPreviewHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="248dp"
            android:layout_marginTop="176dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_toast"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="模拟图传画面 · 未接收到 RTSP 视频流"
            android:textColor="#FFB340"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- ===== 顶部状态栏（对应 .topbar，46dp） ===== -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_topbar_gradient"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- 品牌 Logo -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/detect_app_name"
            android:src="@drawable/ic_logo" />

        <!-- 状态徽章（对应 .status-badge） -->
        <LinearLayout
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_idle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/shape_dot" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:text="非检测"
                android:textColor="@color/dt_txt"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 线路 / 杆塔（模式信息已下沉到底部控制条，避免与 btnMode 重复） -->
        <TextView
            android:id="@+id/tvTopLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxWidth="120dp"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="11.5sp"
            tools:text="750kV城苏2线" />

        <TextView
            android:id="@+id/tvTopTower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="11.5sp"
            tools:text="杆塔 #020" />

        <!-- 弹性间隔 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 图传链路信号 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSigLine1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/dt_txt2"
                android:textSize="10sp"
                tools:text="信号 100% · 11ms" />

            <TextView
                android:id="@+id/tvSigLine2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/dt_txt2"
                android:textSize="10sp"
                tools:text="强度 -58dBm" />
        </LinearLayout>

        <!-- 双电池（对应 .bats） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.skydroid.insulatordetect.ui.BatteryView
                android:id="@+id/batRobot"
                android:layout_width="12dp"
                android:layout_height="18dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="机器人"
                    android:textColor="#E6FFFFFF"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvBatRobot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    tools:text="82%" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:background="#3DFFFFFF" />

            <com.skydroid.insulatordetect.ui.BatteryView
                android:id="@+id/batAndroid"
                android:layout_width="12dp"
                android:layout_height="18dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安卓"
                    android:textColor="#E6FFFFFF"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvBatAndroid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    tools:text="76%" />
            </LinearLayout>
        </LinearLayout>

        <!-- ⋯ 菜单按钮（40dp 触控热区） -->
        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dots"
            android:contentDescription="菜单"
            android:padding="9dp"
            android:src="@drawable/ic_dots" />
    </LinearLayout>

    <!-- 顶栏底部绿色分隔线（对应 .topbar::after） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:layout_marginTop="44dp"
        android:background="@color/dt_green" />

    <!-- ===== 左侧绝缘子串面板（240dp × y 44..338） ===== -->
    <LinearLayout
        android:id="@+id/stringPanel"
        android:layout_width="240dp"
        android:layout_height="294dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_left_panel"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <!-- 相别 + 串布置（tvStrInfo 不再重复相别文字） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@drawable/bg_phase_ind"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前相别"
                android:textColor="@color/dt_txt2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:textColor="@color/dt_green"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="A相" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStrInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="98dp"
                android:singleLine="true"
                android:textColor="@color/dt_txt2"
                android:textSize="10sp"
                tools:text="双联 左串/右串" />
        </LinearLayout>

        <!-- 统计三段：已测 / 合格 / 劣化（顶栏不再重复展示） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_stat_cell"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTopDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/dt_txt3"
                android:textSize="11sp"
                tools:text="已测 0/60" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#1AFFFFFF" />

            <TextView
                android:id="@+id/tvOkBad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/dt_green"
                android:textSize="11sp"
                tools:text="合格 0" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#1AFFFFFF" />

            <TextView
                android:id="@+id/tvTopBad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/dt_red"
                android:textSize="11sp"
                tools:text="劣化 0" />
        </LinearLayout>

        <!-- 绝缘子片列表（对应 .piece-list），单行 41dp / 双联行 34dp 触控高度 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPieces"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="2dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- ===== 视频区遥测条（环境 / 档位阈值 / 探针，单行三列） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="248dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_info_strip"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tvEnv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="10sp"
            tools:text="环境 20℃ · 33%RH · 风 3.2m/s" />

        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:background="#1AFFFFFF" />

        <TextView
            android:id="@+id/tvKvTh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="10sp"
            tools:text="50kV · 阈值 500MΩ" />

        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:background="#1AFFFFFF" />

        <TextView
            android:id="@+id/tvProbe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="10sp"
            tools:text="探针 复位" />
    </LinearLayout>

    <!-- ===== 图传水印（对应 drawVideo 中 CAM1 水印） ===== -->
    <TextView
        android:id="@+id/tvWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="248dp"
        android:layout_marginTop="84dp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:textColor="#80FFFFFF"
        android:textSize="10.5sp"
        tools:text="CAM1 · 1080P · 09:24:31" />

    <!-- ===== 录制计时器（对应 .rec-timer，仅录制时可见） ===== -->
    <LinearLayout
        android:id="@+id/recTimer"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="386dp"
        android:layout_marginTop="82dp"
        android:background="@drawable/bg_rec_timer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:id="@+id/recDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_rec_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="REC"
            android:textColor="@color/white"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvRecTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 报警条容器（瞬态浮层，不拦截触摸；隐藏时 translationY 上移并被容器裁剪） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="248dp"
        android:layout_marginTop="118dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/alarmBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_alarm_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:translationY="-90dp"
            tools:translationY="0dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="报警"
                android:src="@drawable/ic_alarm" />

            <TextView
                android:id="@+id/tvAlarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="发现劣化绝缘子"
                android:textColor="@color/white"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 右下曲线面板（240dp × y 219..330，顶边让出 y176 浮层带） ===== -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="70dp"
        android:background="@drawable/bg_curve_panel"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="高压冲击响应曲线（kV）"
            android:textColor="@color/dt_txt2"
            android:textSize="11sp" />

        <com.skydroid.insulatordetect.ui.CurveView
            android:id="@+id/curveView"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- ===== Toast 容器（瞬态浮层，不拦截触摸；与图传提示共用 y176 浮层带，避开曲线面板） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="248dp"
        android:layout_marginTop="176dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/customToast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:background="@drawable/bg_toast"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="7dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            android:textColor="@color/dt_txt"
            android:textSize="12sp"
            tools:alpha="1"
            tools:text="提示消息" />
    </LinearLayout>

    <!-- ===== 底部控制条（y 338..400，全部操作按钮高度 44dp） ===== -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- 手柄按键/通道显示条（需求3：按了哪个按钮，界面有显示） -->
        <HorizontalScrollView
            android:id="@+id/rcStripScroll"
            android:layout_width="190dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_stat_cell"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rcStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 弹性间隔：把操作按钮推到右侧拇指区 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 拍照（图标按钮，44dp 圆形热区） -->
        <FrameLayout
            android:id="@+id/btnShot"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_cam_btn">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="拍照"
                android:src="@drawable/ic_camera" />
        </FrameLayout>

        <!-- 模式切换（对应 #modeBtn，模式状态即按钮文案，顶栏不再重复） -->
        <LinearLayout
            android:id="@+id/btnMode"
            android:layout_width="76dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ctl_pill"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMode"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="切换检测模式"
                android:src="@drawable/ic_mode" />

            <TextView
                android:id="@+id/tvMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:text="自动"
                android:textColor="@color/dt_txt2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 开始检测主按钮（对应 #startBtn） -->
        <LinearLayout
            android:id="@+id/btnStart"
            android:layout_width="104dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ctl_pill_main"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivStart"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="开始检测"
                android:src="@drawable/ic_play" />

            <TextView
                android:id="@+id/tvStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:text="开始检测"
                android:textColor="@color/dt_green"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 录制（对应 #recBtn） -->
        <LinearLayout
            android:id="@+id/btnRec"
            android:layout_width="76dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ctl_pill"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRec"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="录制"
                android:src="@drawable/ic_record" />

            <TextView
                android:id="@+id/tvRec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:text="录制"
                android:textColor="@color/dt_txt2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 急停（对应 #estopBtn） -->
        <LinearLayout
            android:id="@+id/btnEstop"
            android:layout_width="76dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ctl_pill_stop"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="急停"
                android:src="@drawable/ic_estop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:text="急停"
                android:textColor="@color/dt_red"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 拍照白闪（对应 .flash，覆盖全屏最高层） ===== -->
    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/white" />

    <!-- ===== 右侧抽屉遮罩（对应 .drawer-mask） ===== -->
    <View
        android:id="@+id/drawerMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#59000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- ===== 右侧抽屉（对应 .drawer，400dp = 屏宽 62.5%） ===== -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/dt_drawer_bg"
        android:orientation="horizontal"
        android:translationX="430dp">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/drawerPager"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1AFFFFFF" />

        <!-- 竖排 Tab（对应 .drawer-tabs，56dp 触控宽度） -->
        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dtabLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dtab"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:text="线路设置"
                android:textColor="@color/dt_txt2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dtabParam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dtab"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:text="参数配置"
                android:textColor="@color/dt_txt2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dtabSys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dtab"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:text="系统信息"
                android:textColor="@color/dt_txt2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
