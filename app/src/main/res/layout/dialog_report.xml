<?xml version="1.0" encoding="utf-8"?>
<!--
  检测报告弹窗（对应 HTML .modal-mask/.modal）
  适配 640×400dp 横屏：外层 ScrollView 兜底，内容压缩到约 360dp 高，
  统计格由 3×2 大格改为紧凑格，异常明细固定 96dp 内滚动。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_modal"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检测报告（预览）"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRptSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/dt_txt2"
            android:textSize="11sp"
            tools:text="750kV城苏2线 #020 · A相 · 双联 左串/右串 · 2026-09-17 09:24" />

        <!-- 统计格（对应 .rpt-grid，3列 × 2行，紧凑样式） -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:columnCount="3"
            android:rowCount="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="7dp"
                android:background="@drawable/bg_rpt_cell"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="6dp"
                android:paddingEnd="9dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="检测片数"
                    android:textColor="@color/dt_txt2"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/rTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:text="0"
                    android:textColor="@color/dt_txt"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="7dp"
                android:background="@drawable/bg_rpt_cell"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="6dp"
                android:paddingEnd="9dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="合格"
                    android:textColor="@color/dt_txt2"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/rOk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:text="0"
                    android:textColor="@color/dt_green"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginBottom="7dp"
                android:background="@drawable/bg_rpt_cell"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="6dp"
                android:paddingEnd="9dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="劣化 / 零值"
                    android:textColor="@color/dt_txt2"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/rBad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:text="0"
                    android:textColor="@color/dt_red"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_rpt_cell"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="6dp"
                android:paddingEnd="9dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="线路零值率"
                    android:textColor="@color/dt_txt2"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/rRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:text="0.0%"
                    android:textColor="@color/dt_red"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_rpt_cell"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="6dp"
                android:paddingEnd="9dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="判据"
                    android:textColor="@color/dt_txt2"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:text="高压脉冲 DL/T 626-2024"
                    android:textColor="@color/dt_txt"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_rpt_cell"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="6dp"
                android:paddingEnd="9dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="阈值"
                    android:textColor="@color/dt_txt2"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/rTh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:text="500MΩ"
                    android:textColor="@color/dt_txt"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="异常片明细"
            android:textColor="@color/dt_txt2"
            android:textSize="11sp" />

        <!-- 异常明细列表（对应 .rpt-list，固定 96dp 内滚动，保证弹窗不超屏高） -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_rpt_list"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/rptList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- 操作按钮：40dp 触控高度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnExpWord"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_act_ghost"
                android:gravity="center"
                android:singleLine="true"
                android:text="导出 Word"
                android:textColor="@color/dt_blue"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnExpPdf"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_act_ghost"
                android:gravity="center"
                android:singleLine="true"
                android:text="导出 PDF"
                android:textColor="@color/dt_blue"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCloseRpt"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_act_primary"
                android:gravity="center"
                android:singleLine="true"
                android:text="关闭"
                android:textColor="@color/dt_primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
