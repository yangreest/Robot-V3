<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_pairing"
                    style="@style/smallButton"
                    android:layout_marginEnd="10dp"
                    android:text="对频" />

                <Button
                    android:id="@+id/btn_clear"
                    style="@style/smallButton"
                    android:text="清屏" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="收发格式:"/>
                <RadioGroup
                    android:id="@+id/rg_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/rb_data_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TXT"/>

                    <RadioButton
                        android:id="@+id/rb_data_hex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEX"/>
                </RadioGroup>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:text="手型:"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_set_control_mode"
                    style="@style/smallButton"
                    android:layout_marginEnd="10dp"
                    android:text="设置" />

                <Button
                    android:id="@+id/btn_get_control_mode"
                    style="@style/smallButton"
                    android:text="读取" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_get_channels"
                style="@style/smallButton"
                android:text="获取摇杆杆量值" />

            <Button
                android:id="@+id/btn_get_channels_settings"
                style="@style/smallButton"
                android:text="获取摇杆通道设置" />


            <Button
                android:id="@+id/btn_get_signal"
                style="@style/smallButton"
                android:text="获取遥控器信号" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:text="C10P:"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_akey"
                    style="@style/smallButton"
                    android:layout_marginEnd="10dp"
                    android:text="旧固件" />

                <Button
                    android:id="@+id/btn_akey_027"
                    style="@style/smallButton"
                    android:text=">0.2.6固件" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="5dp"
                    android:text="新网口三体相机\n(UDP):"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_led"
                    style="@style/smallButton"
                    android:layout_marginEnd="10dp"
                    android:text="旧固件" />

                <Button
                    android:id="@+id/btn_led_027"
                    style="@style/smallButton"
                    android:text=">0.2.6固件" />
            </LinearLayout>

            <!-- ==================== 数传 / UDP 测试面板 ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="数传 / UDP 测试"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_link_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="机型:--  管道:未创建  状态:未连接"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rg_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_link_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="SDK数传(按机型自动)"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_link_g12g20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G12G20专用管道"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_link_udp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自定义UDP"
                    android:textSize="13sp" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本地端口" />

                <EditText
                    android:id="@+id/et_local_port"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="14550"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="对端端口" />

                <EditText
                    android:id="@+id/et_remote_port"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="14550"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="对端IP" />

                <EditText
                    android:id="@+id/et_remote_ip"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="text"
                    android:text="192.168.144.108"
                    android:textSize="13sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cb_udp_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="只收对端IP的数据(SDK默认)"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_link_connect"
                    style="@style/smallButton"
                    android:layout_marginEnd="8dp"
                    android:text="连接" />

                <Button
                    android:id="@+id/btn_link_disconnect"
                    style="@style/smallButton"
                    android:layout_marginEnd="8dp"
                    android:text="断开" />

                <Button
                    android:id="@+id/btn_link_reset_stat"
                    style="@style/smallButton"
                    android:text="统计清零" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_link_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TX 0 帧 / 0 B    RX 0 帧 / 0 B"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="周期ms" />

                <EditText
                    android:id="@+id/et_loop_interval"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="1000"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_loop_send"
                    style="@style/smallButton"
                    android:layout_marginStart="8dp"
                    android:text="连续发送" />
            </LinearLayout>

            <!-- ==================== 控制模块协议调试（V1.20） ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="控制模块协议调试(V1.20)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="指令经上方所选数传通道发送，应答解析见右侧日志"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_proto_heartbeat"
                    style="@style/smallButton"
                    android:layout_marginEnd="8dp"
                    android:text="启动心跳" />

                <TextView
                    android:id="@+id/tv_proto_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="心跳:未收到"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="射线机(0x01~0x04)"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="延时s" />

                <EditText
                    android:id="@+id/et_xray_delay"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="15"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_xray_delay"
                    style="@style/smallButton"
                    android:layout_marginStart="4dp"
                    android:text="设延时" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="脉冲" />

                <EditText
                    android:id="@+id/et_xray_pulse"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_xray_pulse"
                    style="@style/smallButton"
                    android:layout_marginStart="4dp"
                    android:text="设脉冲" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_xray_start"
                    style="@style/smallButton"
                    android:layout_marginEnd="8dp"
                    android:text="开启(协议/不延迟)" />

                <Button
                    android:id="@+id/btn_xray_stop"
                    style="@style/smallButton"
                    android:text="停止" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="电机(0x05)"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_motor_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/sp_motor_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使能HEX" />

                <EditText
                    android:id="@+id/et_motor_enable"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="text"
                    android:text="01"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="速度/角度" />

                <EditText
                    android:id="@+id/et_motor_speed"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_motor_run"
                    style="@style/smallButton"
                    android:layout_marginStart="4dp"
                    android:text="运行" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_motor_stop"
                    style="@style/smallButton"
                    android:layout_marginEnd="8dp"
                    android:text="停所选组" />

                <Button
                    android:id="@+id/btn_motor_stop_all"
                    style="@style/smallButton"
                    android:layout_marginEnd="8dp"
                    android:text="停全部" />

                <Button
                    android:id="@+id/btn_motor_brake_all"
                    style="@style/smallButton"
                    android:text="全部刹车" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="电源 / 模式"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_relay_on"
                    style="@style/smallButton"
                    android:layout_marginEnd="6dp"
                    android:text="继电器开" />

                <Button
                    android:id="@+id/btn_relay_off"
                    style="@style/smallButton"
                    android:layout_marginEnd="6dp"
                    android:text="继电器关" />

                <Button
                    android:id="@+id/btn_factory_on"
                    style="@style/smallButton"
                    android:layout_marginEnd="6dp"
                    android:text="进工程模式" />

                <Button
                    android:id="@+id/btn_factory_off"
                    style="@style/smallButton"
                    android:text="退工程模式" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="传感器(0x11)"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="编号" />

                <EditText
                    android:id="@+id/et_sensor_index"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="0"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_detect_start"
                    style="@style/smallButton"
                    android:layout_marginStart="4dp"
                    android:text="触发检测" />

                <Button
                    android:id="@+id/btn_detect_stop"
                    style="@style/smallButton"
                    android:layout_marginStart="6dp"
                    android:text="停止检测" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_sensor_status"
                    style="@style/smallButton"
                    android:layout_marginEnd="6dp"
                    android:text="查状态" />

                <Button
                    android:id="@+id/btn_sensor_battery"
                    style="@style/smallButton"
                    android:layout_marginEnd="6dp"
                    android:text="查电量" />

                <Button
                    android:id="@+id/btn_sensor_result"
                    style="@style/smallButton"
                    android:text="查结果" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="X值校准(0x17)  阻值单位MΩ"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="K" />

                <EditText
                    android:id="@+id/et_calib_k"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="10"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_calib_write_k"
                    style="@style/smallButton"
                    android:layout_marginStart="4dp"
                    android:text="写K" />

                <Button
                    android:id="@+id/btn_calib_read_k"
                    style="@style/smallButton"
                    android:layout_marginStart="6dp"
                    android:text="读K" />

                <Button
                    android:id="@+id/btn_calib_reset"
                    style="@style/smallButton"
                    android:layout_marginStart="6dp"
                    android:text="恢复默认" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_calib_query_raw"
                    style="@style/smallButton"
                    android:layout_marginEnd="6dp"
                    android:text="查原始值" />

                <Button
                    android:id="@+id/btn_calib_read_coef"
                    style="@style/smallButton"
                    android:text="读公式系数" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="原始值" />

                <EditText
                    android:id="@+id/et_calib_raw"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="788"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_calib_verify"
                    style="@style/smallButton"
                    android:layout_marginStart="4dp"
                    android:text="补偿验证" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="标准值" />

                <EditText
                    android:id="@+id/et_calib_std"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal"
                    android:text="500"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_calib_single"
                    style="@style/smallButton"
                    android:layout_marginStart="4dp"
                    android:text="单点定标" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="自动行走配置(0x18)  单位ms"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="继续行走" />

                <EditText
                    android:id="@+id/et_walk_continue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="1000"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="超时退出" />

                <EditText
                    android:id="@+id/et_walk_timeout"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="6000"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_walk_write"
                    style="@style/smallButton"
                    android:layout_marginStart="4dp"
                    android:text="写" />

                <Button
                    android:id="@+id/btn_walk_read"
                    style="@style/smallButton"
                    android:layout_marginStart="6dp"
                    android:text="读" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="配置参数(0x0D)"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="激光近" />

                <EditText
                    android:id="@+id/et_cfg_lidar_min"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="100"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="远" />

                <EditText
                    android:id="@+id/et_cfg_lidar_max"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="2000"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安全轮角度" />

                <EditText
                    android:id="@+id/et_cfg_safe_angle"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal"
                    android:text="10"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="成像板角度" />

                <EditText
                    android:id="@+id/et_cfg_panel_angle"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal"
                    android:text="10"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="异常电压阈值(V)"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="行走" />

                <EditText
                    android:id="@+id/et_cfg_v_walk"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal"
                    android:text="1"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="安全" />

                <EditText
                    android:id="@+id/et_cfg_v_safe"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal"
                    android:text="1"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="成像" />

                <EditText
                    android:id="@+id/et_cfg_v_panel"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal"
                    android:text="1"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="卷扬" />

                <EditText
                    android:id="@+id/et_cfg_v_winch"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal"
                    android:text="1"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="备用" />

                <EditText
                    android:id="@+id/et_cfg_v_winch2"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="numberDecimal"
                    android:text="1"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="成像板运行ms" />

                <EditText
                    android:id="@+id/et_cfg_panel_run"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:text="5000"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_cfg_send"
                    style="@style/smallButton"
                    android:layout_marginStart="8dp"
                    android:text="下发配置" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="OTA升级(0x0A~0x0C)"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_ota_file"
                    style="@style/smallButton"
                    android:layout_marginEnd="6dp"
                    android:text="选固件升级" />

                <Button
                    android:id="@+id/btn_ota_enter"
                    style="@style/smallButton"
                    android:layout_marginEnd="6dp"
                    android:text="进OTA" />

                <Button
                    android:id="@+id/btn_ota_exit"
                    style="@style/smallButton"
                    android:text="退OTA" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ota_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OTA:空闲"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_rc_buttons"
                style="@style/smallButton"
                android:layout_marginTop="10dp"
                android:text="自定义遥控器通道" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="6"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            android:layout_weight="1" />

        <!-- 数传收发追加日志（时间戳 + 方向 + 长度 + 内容） -->
        <ScrollView
            android:id="@+id/sv_link_log"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="2"
            android:background="#11000000">

            <TextView
                android:id="@+id/tv_link_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="HEX 模式示例：A5 5A 01 00（空格可省略，需偶数个字符）"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_send"
                style="@style/smallButton"
                android:minWidth="80dp"
                android:text="发送" />

            <EditText
                android:id="@+id/et_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="123456"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>