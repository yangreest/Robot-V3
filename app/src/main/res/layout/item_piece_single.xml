<?xml version="1.0" encoding="utf-8"?>
<!--
  绝缘子片列表项-单联（对应 .piece，含序号 .idx）
  240dp 面板下单行可用宽 216dp，行高 41dp（触控友好）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pieceRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_piece_idle"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingTop="5dp"
    android:paddingEnd="7dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/tvIdx"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:singleLine="true"
        android:textColor="@color/dt_txt2"
        android:textSize="12sp"
        tools:text="12" />

    <com.skydroid.insulatordetect.ui.InsulatorIconView
        android:id="@+id/iconInsulator"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="7dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/dt_txt3"
            android:textSize="12sp"
            tools:text="1250 MΩ" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/dt_txt2"
            android:textSize="10.5sp"
            tools:text="合格" />
    </LinearLayout>
</LinearLayout>
