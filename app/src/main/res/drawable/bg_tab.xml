<?xml version="1.0" encoding="utf-8"?>
<!-- 左侧 Tab 选择器（对应 .tab / .tab.on） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/dt_green_16" />
            <stroke android:width="1dp" android:color="@color/dt_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/dt_black_35" />
            <stroke android:width="1dp" android:color="@color/dt_line" />
        </shape>
    </item>
</selector>
